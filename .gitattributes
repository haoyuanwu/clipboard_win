* text=auto
*.dart text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.lock text eol=lf
*.json text eol=lf
*.cpp text eol=lf
*.cc text eol=lf
*.h text eol=lf
*.txt text eol=lf
*.cmake text eol=lf
*.py text eol=lf
*.ps1 text eol=crlf
*.iss text eol=crlf
# Unified diffs require a space on blank context lines.
patches/*.patch text eol=lf whitespace=-blank-at-eol
*.png binary
*.ico binary
